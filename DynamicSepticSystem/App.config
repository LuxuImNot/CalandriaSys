<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cadena de conexión real en connectionStrings.config, que NO se versiona
       (ver .gitignore). Copia connectionStrings.config.example y pon los valores reales. -->
  <connectionStrings configSource="connectionStrings.config" />
  <!-- GitHubToken NO vive aquí: está en secrets.config, que no se versiona.
       Copia secrets.config.example a secrets.config y pon el valor real. -->
  <appSettings file="secrets.config">
    <!-- URL base del Web API (Calandria.Api). MISMO servidor y MISMO puerto que el
         cliente espejo (ProgramC#\DynamicSepticSystem): 8733, el servicio
         "CalandriaApi" que ya corre ahí. El 8734 quedó apuntando a un servicio
         CalandriaSysApi que no está levantado, y con eso el panel web (PanelWeb)
         abría en blanco. -->
    <add key="ApiBaseUrl" value="http://100.75.234.9:8733" />
    <!-- Panel principal híbrido: el área central (plano de sembrado + ficha de
         casa) se sustituye por la UI web que sirve el API en api/ui/panel.
         false = panel WinForms clásico, sin recompilar. -->
    <add key="PanelWeb" value="true" />
    <!-- Destajos híbrido: FormActivarTareasTreeList sustituye su panel paso-a-paso
         por la UI web que sirve el API en api/ui/destajos.
         false = formulario WinForms clásico, sin recompilar. -->
    <add key="DestajosWeb" value="true" />
    <!-- Almacén híbrido: FormAlmacen sustituye su panel clásico (entradas, salidas,
         inventario, historial, consulta por casa) por la UI web que sirve el API
         en api/ui/almacen. false = formulario WinForms clásico, sin recompilar. -->
    <add key="AlmacenWeb" value="true" />
    <!-- Compras híbrido: FormComprasWeb sustituye a FormCompraMulti/FormCompraIndirecta
         por la UI web que sirve el API en api/ui/compras (orden múltiple, compra
         indirecta y consulta de órdenes en una sola página con rail de navegación).
         false = formularios WinForms clásicos, sin recompilar. -->
    <add key="ComprasWeb" value="true" />
    <!-- Trabajadores híbrido: FormTrabajadoresWeb sustituye a FormRegistrarTrabajador/
         FormAsignarCuadrilla/FormPerfilTrabajador por la UI web que sirve el API en
         api/ui/trabajadores (registro, cuadrillas y perfil con recibos en una sola
         página con rail de navegación). false = formularios WinForms clásicos, sin
         recompilar. -->
    <add key="TrabajadoresWeb" value="true" />
    <!-- Editor de Tareas híbrido: FormEditorTreeList sustituye su TreeListView clásico
         por la UI web que sirve el API en api/ui/editor-tareas (árbol de 3 niveles,
         columnas personalizadas y gestor de insumos). Requiere rol Admin para guardar.
         false = formulario WinForms clásico, sin recompilar. -->
    <add key="EditorTareasWeb" value="true" />
    <!-- Evidencias híbrido: FormEvidenciasWeb sustituye a FormEvidenciasFotograficas
         por la UI web que sirve el API en api/ui/evidencias (galería por casa: agregar,
         ver a pantalla completa, borrar y exportar PDF).
         false = formulario WinForms clásico, sin recompilar. -->
    <add key="EvidenciasWeb" value="true" />
    <!-- Solo build DEBUG: si ambas tienen valor, al depurar se salta el login del
         todo y se obtiene el token JWT con estas credenciales. Vacías = se pide
         login una vez para conseguir el token. NO se usan en Release. -->
    <add key="DebugUser" value="" />
    <add key="DebugPass" value="" />
    <!-- Configuración para actualizaciones desde GitHub. Canal PROPIO de
         CalandriaSys: NO usar "CalandriaApp" (el de Pilaris) o este cliente se
         actualiza con el otro producto encima y pierde el rebrand/Avance Masivo.
         Los dos repos comparten numeración: cada release de Pilaris se publica
         también aquí con el mismo -Version (ver publicar-release.ps1). -->
    <add key="GitHubOwner" value="LuxuImNot" />
    <add key="GitHubRepo" value="CalandriaSys" />
    <!-- Valor real en secrets.config -> GitHubToken -->
    <add key="GitHubToken" value="" />
    <!-- Seguridad del actualizador (Actualizador.cs):
         RequireUpdateHash: si "true", la actualización SOLO se aplica si el paquete trae
           su hash publicado como "<zip>.sha256" y coincide. Déjalo en "false" hasta que
           empieces a publicar el .sha256 junto a cada release; luego ponlo en "true".
         UpdateSignerThumbprint: si se define, Updater.exe debe estar firmado (Authenticode)
           con ese certificado (thumbprint) o la actualización se bloquea. Vacío = se omite. -->
    <add key="RequireUpdateHash" value="true" />
    <add key="UpdateSignerThumbprint" value="" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.1.0" newVersion="6.0.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.2.0" newVersion="4.0.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.5.0" newVersion="4.1.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.4.0" newVersion="4.0.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Portable.System.DateTimeOnly" publicKeyToken="16fb7a27ac3b9689" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.1" newVersion="9.0.0.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>