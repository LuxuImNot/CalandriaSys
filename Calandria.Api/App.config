<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Secretos (JwtSecreto, GeminiApiKey) NO viven aquí: están en secrets.config,
       que no se versiona (ver .gitignore) y solo existe en cada máquina/servidor.
       Copia secrets.config.example a secrets.config y pon los valores reales. -->
  <appSettings file="secrets.config">
    <!-- URL en la que escucha el servicio. '+' = todas las interfaces (incluida la
         Tailscale 100.75.234.9). Con HttpListener el comodín es '+', no 0.0.0.0.
         Para depurar el host localmente sin admin, cambiar a http://localhost:8734. -->
    <add key="BaseUrl" value="http://+:8734" />

    <!-- Logging detallado de transacciones: vuelca el cuerpo de POST/PUT/PATCH y el
         usuario autenticado (excluye login/evidencias/fotos/conciliar-factura para no
         registrar contraseñas ni base64). true por defecto; pon "false" para solo la
         línea resumida. Útil al correr el API en consola (consola.bat). -->
    <add key="LogDetallado" value="true" />

    <!-- Secreto de firma JWT (HS256, mínimo 32 bytes) en secrets.config -> JwtSecreto. -->
    <add key="JwtIssuer" value="Calandria.Api" />
    <add key="JwtAudience" value="CalandriaCliente" />
    <add key="JwtHorasVigencia" value="2" />

    <!-- Emparejador automático para conciliar facturas (CFDI) contra la OC. Empareja las
         descripciones de la factura que no cuadran por clave/nombre con las partidas de la
         orden. OPCIONAL: con IaProveedor vacío o "None" la conciliación funciona solo con el
         cotejo determinista. Proveedor: "Ollama" (local, gratis, privado: los datos de la
         factura NO salen del servidor) o "Gemini" (requiere key e Internet). -->
    <add key="IaProveedor" value="Ollama" />

    <!-- Ollama local. Instala Ollama en el servidor, ejecuta `ollama pull llama3.1` y deja
         el servicio corriendo (escucha en localhost:11434 por defecto). El modelo debe estar
         descargado. Alternativas buenas para JSON/español: qwen2.5, mistral. -->
    <add key="OllamaUrl" value="http://localhost:11434" />
    <add key="OllamaModel" value="llama3.2" />

    <!-- Gemini API key (solo se usa si IaProveedor="Gemini") en secrets.config -> GeminiApiKey. -->
    <add key="GeminiModel" value="gemini-2.0-flash" />

    <!-- Usuarios (Usuarios.Nombre) con acceso a /api/clientes (alta de clientes nuevos).
         Separados por coma. NO vive en Perfiles/Permisos a propósito, eso lo controla
         cada cliente. Valor real (tu propio usuario) en secrets.config -> SuperAdmins. -->
    <add key="SuperAdmins" value="" />
  </appSettings>
  <!-- Cadena de conexión real en connectionStrings.config, que NO se versiona
       (ver .gitignore). Copia connectionStrings.config.example y pon los valores reales. -->
  <connectionStrings configSource="connectionStrings.config" />
</configuration>
