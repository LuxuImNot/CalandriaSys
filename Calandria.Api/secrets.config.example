<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla. Copia este archivo a "secrets.config" (gitignorado) y pon los valores reales. -->
<appSettings>
  <add key="JwtSecreto" value="GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES" />
  <add key="GeminiApiKey" value="" />
  <!-- AES-256 en Base64 (32 bytes). Genera una con: openssl rand -base64 32 -->
  <add key="DocEncryptionKey" value="GENERA_UNA_CLAVE_AES256_DE_32_BYTES_EN_BASE64" />
  <!-- Tu usuario (Usuarios.Nombre) de producción, con acceso a /api/clientes. Separados por coma. -->
  <add key="SuperAdmins" value="TU_USUARIO_AQUI" />
</appSettings>
